# 策略三（股期刷單）本地環境變數範本。
# 複製成 .env.scalper（同目錄）並填入實際值——.env.scalper 已被 .gitignore 排除，不會進版控。

# ── 永豐 Shioaji API（模擬環境的 Key 申請完即可用；真金 CA 憑證 Phase 4 才需要）──
SHIOAJI_API_KEY=your_key_here
SHIOAJI_SECRET_KEY=your_secret_here
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=
SHIOAJI_SIMULATION=true

# ── 推播 ──
SCALPER_DISCORD_WEBHOOK=

# ── v0 風控參數（見 docs/scalper-spec.md §0 A3，未核准變更前勿改動）──
STOP_LOSS_TICKS=2
TAKE_PROFIT_TICKS=1
MAX_INVENTORY_LOTS=1
DAILY_LOSS_LIMIT=3000.0
CONSECUTIVE_LOSS_PAUSE=3
CONSECUTIVE_LOSS_PAUSE_MINUTES=30
