# ── Supabase（資料庫）──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ── Upstash Redis（Celery Broker）──────────────────────────
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6380

# ── 美股資料 ────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_key_here

# ── 台股資料 ────────────────────────────────────────────────
FUGLE_API_KEY=your_key_here

# ── 券商 API（至少設定一個）──────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

YUANTA_API_KEY=your_key_here
YUANTA_SECRET=your_secret_here

# ── 警報 ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Gemini API（覆盤 AI 分析，免費方案即可）─────────────────
# 取得方式：aistudio.google.com → Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# ── 系統設定 ─────────────────────────────────────────────────
TRADING_MODE=paper
MAX_POSITION_PCT=0.30
MAX_TOTAL_EXPOSURE_PCT=0.80
US_SIGNAL_THRESHOLD=1.5
MA_PERIOD=200
INDEX_STOP_LOSS_PCT=0.12
TRAILING_STOP_PCT=0.15
MIN_CONFIDENCE=0.6
